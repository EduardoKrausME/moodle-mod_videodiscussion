    @template mod_videodiscussion/manage

    Example context (json):
    {
        "hasteacherthreads": true,
        "hasstudentthreads": true
    }
}}
<div class="mod-videodiscussion-manage">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{{#str}}managediscussions, videodiscussion{{/str}}</h2>
        <div>
            <a class="btn btn-primary" href="{{{addurl}}}">{{#str}}addteacherprompt, videodiscussion{{/str}}</a>
            <a class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}backtoactivity, videodiscussion{{/str}}</a>
        </div>
    </div>

    <h3>{{#str}}teacherprompts, videodiscussion{{/str}}</h3>
    {{^hasteacherthreads}}
        <div class="alert alert-light">{{#str}}noteacherprompts, videodiscussion{{/str}}</div>
    {{/hasteacherthreads}}
    {{#hasteacherthreads}}
        <div class="table-responsive mb-4">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>{{#str}}timestamp, videodiscussion{{/str}}</th>
                    <th>{{#str}}subject, videodiscussion{{/str}}</th>
                    <th>{{#str}}group, videodiscussion{{/str}}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {{#teacherthreads}}
                    <tr>
                        <td>{{timecode}}</td>
                        <td>
                            {{subject}}
                            {{#mandatory}}
                                <span class="badge bg-danger">{{#str}}mandatorybadge, videodiscussion{{/str}}</span>
                            {{/mandatory}}
                            {{#requireownpost}}
                                <span class="badge bg-info text-dark">{{#str}}requireownpost, videodiscussion{{/str}}</span>
                            {{/requireownpost}}
                        </td>
                        <td>{{group}}</td>
                        <td class="text-end">
                            {{#canedit}}
                                <a class="btn btn-sm btn-outline-secondary" href="{{{editurl}}}">{{#str}}edit{{/str}}</a>
                            {{/canedit}}
                            {{#candelete}}
                                <a class="btn btn-sm btn-outline-danger" href="{{{deleteurl}}}" data-confirm-delete
                                   data-confirm-message="{{#str}}deleteconfirm, videodiscussion{{/str}}">
                                    {{#str}}delete{{/str}}
                                </a>
                            {{/candelete}}
                        </td>
                    </tr>
                {{/teacherthreads}}
                </tbody>
            </table>
        </div>
    {{/hasteacherthreads}}

    <h3>{{#str}}studentdiscussions, videodiscussion{{/str}}</h3>
    {{^hasstudentthreads}}
        <div class="alert alert-light">{{#str}}nostudentdiscussions, videodiscussion{{/str}}</div>
    {{/hasstudentthreads}}
    {{#hasstudentthreads}}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>{{#str}}timestamp, videodiscussion{{/str}}</th>
                    <th>{{#str}}subject, videodiscussion{{/str}}</th>
                    <th>{{#str}}author, videodiscussion{{/str}}</th>
                    <th>{{#str}}group, videodiscussion{{/str}}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {{#studentthreads}}
                    <tr>
                        <td>{{timecode}}</td>
                        <td>{{subject}}</td>
                        <td>{{author}}</td>
                        <td>{{group}}</td>
                        <td class="text-end">
                            {{#candelete}}
                                <a class="btn btn-sm btn-outline-danger" href="{{{deleteurl}}}" data-confirm-delete
                                   data-confirm-message="{{#str}}deleteconfirm, videodiscussion{{/str}}">
                                    {{#str}}delete{{/str}}
                                </a>
                            {{/candelete}}
                        </td>
                    </tr>
                {{/studentthreads}}
                </tbody>
            </table>
        </div>
    {{/hasstudentthreads}}
</div>
